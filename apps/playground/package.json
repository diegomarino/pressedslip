{
  "name": "pressedslip-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prerender:hero": "tsx scripts/pre-render-hero.mjs",
    "build": "pnpm prerender:hero && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "serve": "pnpm build && pnpm preview",
    "dev": "vite --port 4173 --strictPort",
    "test": "vitest run src",
    "test:smoke": "playwright test",
    "verify": "pnpm test && pnpm build && tsx scripts/verify-variants.mjs && node ../../scripts/check-bundle-size.mjs && start-server-and-test 'vite preview --port 4173 --strictPort' http://localhost:4173 'playwright test'"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/common": "^1.5.5",
    "@lezer/json": "^1.0.3",
    "@uiw/react-codemirror": "^4.25.12",
    "harfbuzzjs": "0.10.0",
    "jsonc-parser": "^3.3.1",
    "pressedslip": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^2.1.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "start-server-and-test": "^2.1.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
