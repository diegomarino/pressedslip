{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "pressedslip": ["./src/index.ts"],
      "pressedslip/testing": ["./src/testing/index.ts"],
      "pressedslip/providers": ["./src/providers/index.ts"],
      "pressedslip/browser": ["./src/browser/index.ts"],
      "pressedslip/transports": ["./src/transports/index.ts"]
    }
  },
  "include": ["src", "tests"],
  "exclude": [".attic"]
}
